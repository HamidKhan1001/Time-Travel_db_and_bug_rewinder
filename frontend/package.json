{
  "name": "time-travel-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frontend for Time-Travel DB & Bug Rewinder (hackathon build). React + Vite + Tailwind, mock data by default, or the real Python backend with `npm run dev:live`.",
  "scripts": {
    "dev": "vite",
    "dev:live": "vite --mode live",
    "build": "vite build",
    "build:live": "vite build --mode live",
    "preview": "vite preview",
    "test": "node --test src/services/adapters.test.js",
    "lint": "eslint .",
    "test:e2e": "npm run build:live && playwright test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/forms": "^0.5.11",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
