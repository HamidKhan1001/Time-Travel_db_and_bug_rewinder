# Copy to .env.local and fill in when the backend is ready.
# No secrets belong in the frontend: anything prefixed VITE_ is shipped to the browser.

# true  = use the mock data in src/mocks (default, no backend needed)
# false = call the real backend through src/services/api.js
VITE_USE_MOCKS=true

# Base URL of the backend API, e.g. http://localhost:8000 (agreed with the backend team)
VITE_API_BASE_URL=

# --- Optional tuning (all have sensible defaults) ---
# Per-request timeout, and how many times a failed GET is retried (writes are never retried).
# VITE_API_TIMEOUT_MS=30000
# VITE_API_MAX_RETRIES=2
# VITE_API_RETRY_BASE_MS=400
# VITE_API_RETRY_MAX_WAIT_MS=10000
# How often the console polls a running recovery, and the longest it waits.
# VITE_POLL_INTERVAL_MS=350
# VITE_RECOVERY_MAX_WAIT_MS=120000
# localStorage key that holds the bearer token when the server runs with TT_API_TOKEN.
# VITE_TOKEN_STORAGE_KEY=tt_api_token
